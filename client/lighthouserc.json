{
    "ci": {
        "collect": {
            "staticDistDir": "./dist",
            "numberOfRuns": 3,
            "url": [
                "http://localhost:7001/"
            ]
        },
        "upload": {
            "target": "temporary-public-storage"
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "error",
                    {
                        "minScore": 0.7
                    }
                ],
                "categories:accessibility": [
                    "error",
                    {
                        "minScore": 0.9
                    }
                ],
                "categories:best-practices": [
                    "warn",
                    {
                        "minScore": 0.8
                    }
                ]
            }
        }
    }
}